# Uso local: README.md. Operação remota: documentation/OPERATIONS.md.
# Publicação e Analytics: documentation/PENDING.md.
# Os grupos remotos não são necessários para iniciar a aplicação local.
# Descomente os opcionais apenas quando for usar o fluxo correspondente.

# Aplicação local
# Define o ambiente da aplicação: local, test, staging ou production.
APP_ENV=local
# Endereço base do site, usado em links e validações de origem.
SITE_ORIGIN=http://localhost:3000
# Segredo de autenticação do CMS. Use pelo menos 32 caracteres.
PAYLOAD_SECRET=
# Conexão com o banco local fixo, usado no desenvolvimento e nos testes.
DATABASE_URI=postgres://adfl:SUBSTITUA@127.0.0.1:5432/a_design_for_life_rebuild
# Nome que separa os arquivos deste ambiente.
MEDIA_BUCKET=adfl-local-files
# Define onde salvar os arquivos: local ou r2. No desenvolvimento, use local.
MEDIA_STORAGE_DRIVER=local

# Conta local do painel
# Usada por pnpm provision:editor. O login normal consulta a conta no banco.
# E-mail da conta administrativa local.
# LOCAL_EDITOR_EMAIL=local-editor@example.invalid
# Senha usada ao criar a conta local.
# LOCAL_EDITOR_PASSWORD=

# Mídias remotas (R2)
# Usadas pelo armazenamento remoto de arquivos.
# Nome do bucket de mídias no R2.
# R2_BUCKET=
# Endereço da API do R2.
# R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# Identificador da chave de acesso às mídias.
# R2_ACCESS_KEY_ID=
# Segredo da chave de acesso às mídias.
# R2_SECRET_ACCESS_KEY=
# Prefixo que separa as mídias dentro do bucket. É opcional.
# R2_MEDIA_PREFIX=

# E-mail remoto (Resend)
# Envio em staging e produção. No local, as mensagens ficam na captura privada.
# Chave da API usada no envio de e-mails.
# RESEND_API_KEY=
# Endereço usado como remetente dos e-mails.
# EDITORIAL_EMAIL_FROM_ADDRESS=a-design-for-life@mail.joeldorosarioo.dev
# Nome que aparece como remetente.
# EDITORIAL_EMAIL_FROM_NAME=A Design for Life

# Acesso ao staging
# Usuário da proteção HTTP, usado nas medições de staging.
# STAGING_BASIC_AUTH_USERNAME=
# Senha da proteção HTTP do staging.
# STAGING_BASIC_AUTH_PASSWORD=
# E-mail da conta editorial usada na inicialização e na importação.
# STAGING_EDITOR_EMAIL=staging-editor@example.invalid
# Senha da conta editorial de staging.
# STAGING_EDITOR_PASSWORD=

# Importação editorial
# Arquivo com o conteúdo aprovado para importação.
# STAGING_SEED_PLAN=.work/staging-seed/plan.private.json
# Pasta dos arquivos usados nessa importação.
# STAGING_SEED_ASSETS_ROOT=.work/staging-seed/assets

# Deploy no Coolify
# Token para consultar e configurar a aplicação.
# COOLIFY_TOKEN=
# Token para iniciar o deploy.
# COOLIFY_DEPLOY_TOKEN=
# Token para consultar e executar o backup antes do deploy.
# COOLIFY_BACKUP_TOKEN=

# Backup remoto
# Destino separado das mídias, com credenciais próprias.
# Bucket exclusivo dos backups.
# OPS_BACKUP_BUCKET=
# Identificador da chave usada nos backups.
# OPS_BACKUP_ACCESS_KEY_ID=
# Segredo da chave usada nos backups.
# OPS_BACKUP_SECRET_ACCESS_KEY=

# Publicação e Analytics
# Indica a abertura pública aprovada do site.
# PUBLIC_SITE_ENABLED=false
# Identifica a propriedade do GA4. Preencher este campo não ativa o Analytics.
# GA4_MEASUREMENT_ID=
