# Guia local em README.md.

# Operação em documentation/OPERATIONS.md.

# Publicação e Analytics em documentation/PENDING.md.

# Aplicação local

# Ambiente da aplicação.
APP_ENV=local

# Endereço base do site.
SITE_ORIGIN=http://localhost:3000

# Segredo do CMS com pelo menos 32 caracteres.
PAYLOAD_SECRET=

# Banco local de desenvolvimento e testes.
DATABASE_URI=postgres://adfl:SUBSTITUA@127.0.0.1:5432/a_design_for_life_rebuild

# Identifica os arquivos do ambiente.
MEDIA_BUCKET=adfl-local-files

# Armazenamento local ou r2.
MEDIA_STORAGE_DRIVER=local

# Conta local do painel (pnpm provision:editor)

# E-mail da conta local.
# LOCAL_EDITOR_EMAIL=local-editor@example.invalid

# Senha para criar a conta local.
# LOCAL_EDITOR_PASSWORD=

# Mídias remotas no R2

# Bucket de mídias.
# R2_BUCKET=

# Endereço da API do R2.
# R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com

# Identificador da chave de mídias.
# R2_ACCESS_KEY_ID=

# Segredo da chave de mídias.
# R2_SECRET_ACCESS_KEY=

# Prefixo opcional das mídias.
# R2_MEDIA_PREFIX=

# E-mail remoto com Resend

# Chave do Resend para staging e produção.
# RESEND_API_KEY=

# E-mail do remetente.
# EDITORIAL_EMAIL_FROM_ADDRESS=a-design-for-life@mail.joeldorosarioo.dev

# Nome do remetente.
# EDITORIAL_EMAIL_FROM_NAME=A Design for Life

# Acesso ao staging

# Usuário da proteção HTTP.
# STAGING_BASIC_AUTH_USERNAME=

# Senha da proteção HTTP.
# STAGING_BASIC_AUTH_PASSWORD=

# E-mail da conta editorial.
# STAGING_EDITOR_EMAIL=staging-editor@example.invalid

# Senha da conta editorial.
# STAGING_EDITOR_PASSWORD=

# Importação editorial

# Arquivo com o conteúdo aprovado.
# STAGING_SEED_PLAN=.work/staging-seed/plan.private.json

# Pasta dos arquivos para importação.
# STAGING_SEED_ASSETS_ROOT=.work/staging-seed/assets

# Deploy no Coolify

# Token de consulta e configuração.
# COOLIFY_TOKEN=

# Token de deploy.
# COOLIFY_DEPLOY_TOKEN=

# Token do backup antes do deploy.
# COOLIFY_BACKUP_TOKEN=

# Backup remoto (separado das mídias)

# Bucket exclusivo dos backups.
# OPS_BACKUP_BUCKET=

# Identificador da chave de backup.
# OPS_BACKUP_ACCESS_KEY_ID=

# Segredo da chave de backup.
# OPS_BACKUP_SECRET_ACCESS_KEY=

# Publicação e Analytics

# Liberação pública do site.
# PUBLIC_SITE_ENABLED=false

# ID do GA4 na produção pública.
# GA4_MEASUREMENT_ID=
