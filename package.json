{
  "name": "a-design-for-life",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.22.2 <25",
    "pnpm": "12.10.1"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "payload": "node --conditions=react-server ./node_modules/payload/bin.js",
    "provision:structural": "node --conditions=react-server ./node_modules/payload/bin.js run src/config/provision-structural-documents.cli.ts",
    "generate:types": "node --conditions=react-server ./node_modules/payload/bin.js generate:types",
    "generate:importmap": "node --conditions=react-server ./node_modules/payload/bin.js generate:importmap",
    "migrate:create": "node --conditions=react-server ./node_modules/payload/bin.js migrate:create",
    "migrate": "node --conditions=react-server ./node_modules/payload/bin.js migrate",
    "setup:media-checker": "node testing/setup/install-qpdf.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "node --conditions=react-server ./node_modules/@playwright/test/cli.js test",
    "test:architecture": "vitest run --project architecture",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "dotenv": "18.0.9",
    "graphql": "16.14.2",
    "next": "16.4.3",
    "payload": "3.92.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dependency-cruiser": "18.7.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
