# Copie para .env (ignorado) e gere valores locais próprios. Nunca use produção em testes.
APP_ENV=local
SITE_ORIGIN=http://127.0.0.1:3000
PAYLOAD_SECRET=
LOCAL_POSTGRES_PASSWORD=
DATABASE_URI=postgres://adfl_local:SUBSTITUA@127.0.0.1:55432/adfl_local
MEDIA_BUCKET=adfl-local-files
# Somente provisionamento local controlado; nunca enviar estes campos ao navegador.
LOCAL_EDITOR_EMAIL=editor-local@example.invalid
LOCAL_EDITOR_PASSWORD=
# E3: apenas configuração futura; preencher segredos no ambiente privado, nunca no Git/chat.
# Local/test mantêm captura de e-mail. Staging/production exigem R2 e Resend completos.
# MEDIA_BUCKET seleciona o bucket real, privado e exclusivo do ambiente no R2.
# MEDIA_STORAGE_DRIVER=r2
# R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# RESEND_API_KEY=
# EDITORIAL_EMAIL_FROM_ADDRESS=a-design-for-life@mail.joeldorosarioo.dev
# EDITORIAL_EMAIL_FROM_NAME=A Design for Life

# Liberação operacional futura, após A4; não é consentimento nem substitui autenticação.
# Permanece ausente/desativada em toda prévia, teste, homologação e candidata privada.
# PUBLIC_SITE_ENABLED=false
# GA4_MEASUREMENT_ID=
